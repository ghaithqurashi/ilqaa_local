# .env.production.template
# Production Environment Template
# DO NOT PUT REAL KEYS HERE - This is a template
# Copy to .env.production and fill in real values

# Environment
ENVIRONMENT=production

# Server settings (Cloud Run defaults)
HOST=0.0.0.0
PORT=8080

# URLs (will be set by Cloud Run/Firebase)
BACKEND_URL=https://ilqaa-backend-xxxxxx-xx.a.run.app
FRONTEND_URL=https://ilqaa-402a3.web.app

# Speechmatics API
SPEECHMATICS_API_KEY=YOUR_PRODUCTION_SPEECHMATICS_API_KEY

# OpenAI Configuration
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=YOUR_PRODUCTION_OPENAI_API_KEY
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3

# Firebase Configuration (for authentication)
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=ilqaa-402a3.firebaseapp.com
FIREBASE_PROJECT_ID=ilqaa-402a3
FIREBASE_STORAGE_BUCKET=ilqaa-402a3.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# Firebase Service Account (for backend verification)
FIREBASE_PRIVATE_KEY=YOUR_FIREBASE_PRIVATE_KEY
FIREBASE_CLIENT_EMAIL=YOUR_FIREBASE_CLIENT_EMAIL

# Security
ALLOWED_USERS=user1@example.com,user2@example.com
JWT_SECRET=YOUR_JWT_SECRET_KEY_HERE