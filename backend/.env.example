# Development Environment
ENVIRONMENT=development

# Real-time Speech-to-Text Configuration
SPEECHMATICS_API_KEY=your-speechmatics-api-key-here

# Choose ONE provider by setting LLM_PROVIDER

# For LM Studio (local)
#LLM_PROVIDER=lm_studio
#LLM_BASE_URL=http://localhost:1234/v1
#LLM_API_KEY=lm-studio
#LLM_MODEL=google/gemma-3-4b
#LLM_MODEL=qwen3-8b

# For OpenAI (cloud)
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-openai-api-key-here
LLM_MODEL=gpt-4.1-mini

# For Ollama (local)
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama2

# For HuggingFace (cloud)
# LLM_PROVIDER=huggingface
# LLM_BASE_URL=https://api-inference.huggingface.co/v1
# LLM_API_KEY=hf-your-token-here
# LLM_MODEL=microsoft/phi-2

# For Gemini through its OpenAI-compatible endpoint (cloud)
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=your-gemini-api-key-here
# LLM_MODEL=gemini-flash-latest

# Optional settings (same for all providers)
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Audio model (optional) – listens to recordings and speaks, for /api/analyze and /api/tts:
#   * pronunciation feedback that listens to the student's recording (PRONUNCIATION_ENGINE=audio)
#   * text-to-speech voices for the model reading
#   * the text tasks too, if no LLM above is configured or PRACTICE_AI_ENGINE=audio
# Without it those features fall back (transcript-only feedback, Google Translate voice).
# (Old names GEMINI_API_KEY / GEMINI_MODELS / GEMINI_TTS_MODELS / GEMINI_TIMEOUT still work.)
#
# Gemini (default provider):
AUDIO_PROVIDER=gemini
AUDIO_API_KEY=
# AUDIO_MODELS=gemini-3.8-flash,gemini-flash-latest,gemini-3.1-flash-lite
# AUDIO_TTS_MODELS=gemini-2.5-flash-preview-tts,gemini-3.1-flash-tts-preview
# AUDIO_TIMEOUT=60
#
# Any OpenAI-compatible API instead (audio input via chat/completions, speech via /audio/speech):
# AUDIO_PROVIDER=openai
# AUDIO_BASE_URL=https://api.openai.com/v1          # or https://openrouter.ai/api/v1
# AUDIO_API_KEY=your-key-here
# AUDIO_MODELS=gpt-4o-audio-preview                 # on OpenRouter e.g. google/gemini-2.5-flash
# AUDIO_TTS_MODELS=gpt-4o-mini-tts,tts-1
# AUDIO_TTS_VOICES=Fenrir=onyx,Charon=echo          # the app's two voices -> provider voices
#
# Text-to-speech from a different provider than listening (optional overrides):
# AUDIO_TTS_PROVIDER=gemini
# AUDIO_TTS_API_KEY=your-gemini-key
# AUDIO_TTS_BASE_URL=

# ---------------------------------------------------------------------------
# Vowelized speech recognition (optional) – writes what the student said WITH short vowels, e.g.
# NAMAA-Space/Cohere-Speech-Tashkeel-2B served by tools/asr-eval/serve_asr.py. The backend compares
# it with the vowelized reference word by word, and the text LLM explains the errors.
# ASR_BASE_URL=http://127.0.0.1:8090/v1
# ASR_MODEL=NAMAA-Space/Cohere-Speech-Tashkeel-2B
# ASR_API_KEY=
# ASR_TIMEOUT=120

# Live transcript on the speaking stage: auto (Speechmatics if SPEECHMATICS_API_KEY is set, otherwise
# the vowelized ASR above), speechmatics, or asr (Arabic only; each sentence appears after a pause)
LIVE_TRANSCRIBER=auto

# ---------------------------------------------------------------------------
# Which engine answers the practice/oratory text tasks: auto (LLM, else audio model, else offline), llm, audio
PRACTICE_AI_ENGINE=auto
# How pronunciation feedback uses the recording: auto (asr, else audio, else text), asr, audio, text
PRONUNCIATION_ENGINE=auto

# Server settings (development)
HOST=127.0.0.1
PORT=8000