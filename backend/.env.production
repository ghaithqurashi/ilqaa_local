# Development Environment
ENVIRONMENT=production

# API Keys (production - will be set as secrets in Cloud Run)
SPEECHMATICS_API_KEY=${SPEECHMATICS_API_KEY}
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=${OPENAI_API_KEY}
LLM_MODEL=gpt-4.1-mini

# Optional settings (same for all providers)
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3

# Server settings (production - Cloud Run will set these)
HOST=0.0.0.0
PORT=8080  # Cloud Run default port

# URLs (will be set by Cloud Run/Firebase)
BACKEND_URL=https://ilqaa-backend-xxxx-xx.a.run.app
FRONTEND_URL=https://ilqaa.ai