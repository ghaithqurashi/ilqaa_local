{
  "hosting": {
    "public": "static",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/coach",
        "destination": "/coach.html"
      },
      {
        "source": "/results",
        "destination": "/results.html"
      },
      {
        "source": "/login",
        "destination": "/login.html"
      },
      {
        "source": "/api/**",
        "destination": "/api/**"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}